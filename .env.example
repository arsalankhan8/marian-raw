# Public browser key. Keep TURNSTILE_SECRET_KEY on the PHP server only.
VITE_TURNSTILE_SITE_KEY=

# Same-origin secure form endpoints. Configure the hosting layer to route these
# paths to the PHP application service without exposing its document root.
VITE_TALENT_API_ENDPOINT=/api/career-application.php
VITE_CONTACT_API_ENDPOINT=/api/contact.php
